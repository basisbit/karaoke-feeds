<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="referrer" content="no-referrer">
<title>{{.Catalog.Name}} · {{.Feed}}</title>
<link rel="icon" href="data:,">
<link rel="stylesheet" href="index.css">
<script src="index.js" defer></script>
</head>
<body>
<header class="hero small">
  <div class="wrap">
    <p class="eyebrow"><a href="./">{{.Feed}}</a></p>
    <h1>{{.Catalog.Name}}</h1>
    <p class="meta">{{num .Catalog.Songs}} songs · {{.Catalog.Size}} · id <code>{{.Catalog.ID}}</code></p>
  </div>
</header>
<main class="wrap">
  <section>
    <div class="filter" hidden>
      <label for="filter">Filter</label>
      <input type="search" id="filter" placeholder="Artist or title" autocomplete="off">
      <span id="filter-count" class="note" aria-live="polite"></span>
    </div>
    <ul class="songs all" id="songs">
    {{range .Catalog.List}}<li><span class="artist">{{.Artist}}</span> – {{.Title}}<span class="lic">{{.License}}</span></li>
    {{end}}</ul>
  </section>
  <p><a href="./">← Back to the feed</a></p>
</main>
<footer><div class="wrap"><p>Generated by kfeed {{.Version}} · <a href="{{.Repo}}">karaoke-feeds on GitHub</a></p>
<p>This page loads nothing from other websites and sets no cookies.</p></div></footer>
</body>
</html>
